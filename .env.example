# ============================================================================
# ACADEMIC DEPARTMENT ASSISTANCE SYSTEM (NEXT GEN GRADING)
# ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="Next Gen Grading - Academic Department Assistance System"
CLIENT_URL=http://localhost:5000

# Database Configuration (PostgreSQL / Supabase)
# Option A: One-line Supabase Connection String (Recommended for Supabase)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option B: Individual PostgreSQL / Supabase parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=next_gen_grading
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Authentication & JWT Configuration
JWT_SECRET=super_secret_academic_jwt_token_key_change_in_production_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=xlsx,xls

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10

# Optional External Chatbot / AI Service API Key (for future LLM enhancement)
# GEMINI_API_KEY=your_gemini_api_key_here
